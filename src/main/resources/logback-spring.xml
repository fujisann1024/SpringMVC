<?xml version="1.0" encoding="UTF-8"?>
<configuration>

  <!-- 1) ここで設定値を完結させる（Springは使わない） -->
  <!-- 環境変数 LOG_DIR があればそれを使い、無ければ logs -->
  <property name="LOG_DIR" value="${LOG_DIR:-logs}"/>

  <!-- 2) 出力先：コンソール -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} trace=%X{traceId:-} req=%X{requestId:-} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- 3) 出力先：ファイル（ローテ） -->
  <appender name="ROLLING" class="ch.qos.logback.core.rolling.RollingFileAppender">
    <file>${LOG_DIR}/app.log</file>

	<!--  -->
    <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
      <fileNamePattern>${LOG_DIR}/app.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
      <maxFileSize>50MB</maxFileSize>
      <maxHistory>14</maxHistory>
      <totalSizeCap>2GB</totalSizeCap>
    </rollingPolicy>

    <encoder>
      <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level %logger{36} trace=%X{traceId:-} req=%X{requestId:-} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- 4) ログレベル：パッケージ単位で制御（Springのlogging.levelを使わない） -->
  <logger name="com.example" level="DEBUG" />
  <logger name="org.springframework" level="INFO" />

  <!-- 5) ルート：全体の最低レベル -->
  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
    <appender-ref ref="ROLLING"/>
  </root>

</configuration>
